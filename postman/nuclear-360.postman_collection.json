{
  "info": {
    "_postman_id": "nuclear-360-semana03-adaptado-2026",
    "name": "Nuclear 360 - Semana 3 - Fluxo Cronológico",
    "description": "Coleção do Nuclear 360 organizada em ordem cronológica de execução. Fluxo: criar pergunta -> buscar -> criar resposta -> consultar respostas -> listar/filtrar -> atualizar -> testar validações/404 -> excluir. As variáveis perguntaId e respostaId são preenchidas automaticamente pelos testes das requests de criação.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "perguntaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "respostaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "nonExistentId",
      "value": "999999",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Fluxo cronológico - Nuclear 360",
      "description": "Execute de cima para baixo no Collection Runner.",
      "item": [
        {
          "name": "Criar pergunta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enunciado\": \"Qual é a principal finalidade de uma API REST?\",\n  \"tipo\": \"MULTIPLA_ESCOLHA\",\n  \"nivelDificuldade\": \"FACIL\",\n  \"explicacao\": \"Uma API REST permite a comunicação entre sistemas por meio de recursos e métodos HTTP.\",\n  \"valorPontos\": 10,\n  \"tempoLimite\": 60,\n  \"dicas\": [\n    \"Pense em comunicação entre aplicações.\",\n    \"Considere o uso do protocolo HTTP.\"\n  ],\n  \"ordem\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pergunta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pergunta"
              ]
            },
            "description": "Cria uma pergunta. O controller força o status inicial para EM_ANALISE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Header Location presente\", () => pm.response.to.have.header(\"Location\"));",
                  "const json = pm.response.json();",
                  "pm.test(\"status inicial é EM_ANALISE\", () => pm.expect(json.status).to.eql(\"EM_ANALISE\"));",
                  "pm.test(\"resposta possui campos esperados\", () => {",
                  "    pm.expect(json).to.have.all.keys(\"id\", \"enunciado\", \"tipo\", \"status\", \"nivelDificuldade\", \"explicacao\", \"valorPontos\", \"tempoLimite\", \"ordem\", \"dicas\");",
                  "});",
                  "pm.collectionVariables.set(\"perguntaId\", json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar pergunta por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pergunta/{{perguntaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pergunta",
                "{{perguntaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"id corresponde ao criado\", () => pm.expect(String(json.id)).to.eql(pm.collectionVariables.get(\"perguntaId\")));"
                ]
              }
            }
          ]
        },
